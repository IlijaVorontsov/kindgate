{
  "manifest_version": 3,
  "name": "Kindgate",
  "version": "6.3",
  "description": "YouTube without Shorts or the Home feed and Instagram limited to the accounts you follow, in Safari. One speed for every video, with speed and seek keys on a Mac. More help for evenings, nights and mornings, off until you switch it on.",
  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },
  "background": {
    "scripts": [
      "migrate.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "css": [
        "brand.css",
        "youtube.css"
      ],
      "js": [
        "youtube.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "yt-rate.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.instagram.com/*",
        "*://instagram.com/*"
      ],
      "css": [
        "brand.css",
        "instagram.css"
      ],
      "js": [
        "instagram.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "brand.css",
        "checkin.css"
      ],
      "js": [
        "migrate.js",
        "checkin.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "css": [
        "brand.css",
        "pip.css"
      ],
      "js": [
        "pip.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "player.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*",
        "*://www.instagram.com/*",
        "*://instagram.com/*"
      ],
      "js": [
        "upsell.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*",
        "*://www.instagram.com/*",
        "*://instagram.com/*"
      ],
      "js": [
        "migrate.js",
        "firstrun.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "brand.css",
        "pause.css"
      ],
      "js": [
        "migrate.js",
        "pause.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "brand.css",
        "warm.css"
      ],
      "js": [
        "migrate.js",
        "warm.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "media-keys.css"
      ],
      "js": [
        "media-keys.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kindgate",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "96": "images/icon-96.png",
      "128": "images/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2",
        "lists/*.txt",
        "checkin.css",
        "pause.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
